# Google Cloud / Vertex AI
GCP_PROJECT=your_gcp_project_id_here
GCP_LOCATION=us-central1

# Set USE_VERTEX_AI=true to use Vertex AI (ADC auth, higher quotas, no API key needed)
# Set USE_VERTEX_AI=false to use Gemini API key (free tier, lower quotas)
USE_VERTEX_AI=false
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
MAX_TOKENS=8192
TEMPERATURE=0.3

# PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5433/holistic_health

# Redis
REDIS_URL=redis://localhost:6379/0

# App
APP_ENV=development
SECRET_KEY=your_secret_key_here
CORS_ORIGINS=["http://localhost:3000"]

# Vector DB (Qdrant)
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=naturopathy_books

ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
